@model IReadOnlyList<EarlyYearsFoundationRecovery.Web.Models.TrainingModuleViewModel>
@{
    ViewData["Title"] = "My modules";
}
<h1>My modules</h1>
@if (Model.Count == 0)
{
    <p>There are no training modules available at the moment.</p>
}
else
{
    <ul class="module-list">
        @foreach (var item in Model)
        {
            <li class="module-card">
                <p class="eyebrow">@((item.State == "completed") ? "Completed" : (item.State == "in-progress") ? "In progress" : "Available")</p>
                <h2><a asp-action="Module" asp-route-moduleName="@item.Module.Name">@item.Module.Title</a></h2>
                @if (item.Module.Pages.Count > 0)
                {
                    <p>@item.VisitedPageCount of @item.Module.Pages.Count pages visited</p>
                }
            </li>
        }
    </ul>
}
