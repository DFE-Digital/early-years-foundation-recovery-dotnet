@model EarlyYearsFoundationRecovery.Web.Models.AssessmentResultViewModel
@{
    ViewData["Title"] = "Your answer";
}
<div class="notification @(Model.Result.Correct ? "notification--success" : "notification--info")" role="status">
    <h1>@(Model.Result.Correct ? "That's right" : "That's not quite right")</h1>
</div>
@if (Model.Question.PageType == "formative")
{
    <partial name="_FormativeFeedback" model="new EarlyYearsFoundationRecovery.Web.Models.FormativeFeedbackViewModel(Model.Question, Model.Result.Correct)" />
}
@{
    var pages = Model.Module.Pages;
    var questionIndex = pages.ToList().FindIndex(page => page.Name == Model.Question.Name);
    var next = questionIndex >= 0 && questionIndex + 1 < pages.Count ? pages[questionIndex + 1] : null;
}
@if (next is not null)
{
    <a class="button" asp-action="Page" asp-route-moduleName="@Model.Module.Name" asp-route-pageName="@next.Name">Continue</a>
}
else
{
    <a class="button" asp-action="Module" asp-route-moduleName="@Model.Module.Name">Return to module</a>
}
