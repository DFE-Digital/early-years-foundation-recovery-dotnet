@model EarlyYearsFoundationRecovery.Web.Models.LocationModel
@{
    ViewData["Title"] = "Where you live";
    var countries = (IReadOnlyList<EarlyYearsFoundationRecovery.Application.Contracts.RegistrationChoice>)ViewBag.Countries;
}
<h1>Where do you live?</h1>
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
<form asp-action="Location" method="post">
    <div class="form-group">
        <label asp-for="Country">Country</label>
        <select asp-for="Country" class="select-input">
            <option value="">Select a country</option>
            @foreach (var country in countries)
            {
                <option value="@country.Id">@country.Name</option>
            }
        </select>
        <span asp-validation-for="Country" class="field-error"></span>
    </div>
    <button class="button" type="submit">Continue</button>
</form>
