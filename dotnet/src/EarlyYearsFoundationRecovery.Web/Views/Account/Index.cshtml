@model EarlyYearsFoundationRecovery.Domain.Accounts.UserAccount
@{
    ViewData["Title"] = "My account";
}
<h1>My account</h1>
<dl class="summary-list">
    <dt>Name</dt>
    <dd>@Model.FirstName @Model.LastName <a asp-controller="Registration" asp-action="Name">Change</a></dd>
    <dt>Email address</dt>
    <dd>@Model.Email</dd>
    <dt>Registration</dt>
    <dd>@(Model.IsRegistrationComplete ? "Complete" : "In progress")</dd>
</dl>
<p><a asp-controller="Account" asp-action="Close">Close your account</a></p>
