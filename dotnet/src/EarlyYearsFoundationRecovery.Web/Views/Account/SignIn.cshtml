@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p>Use GOV.UK One Login to access your account and continue your training.</p>
<div class="notification notification--info">
    <p>Development environment: use the local sign-in button to test the application.</p>
    <form asp-action="DevelopmentSignIn" method="post">
        <button class="button" type="submit">Sign in as a local test user</button>
    </form>
</div>
